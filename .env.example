# Application Configuration
APP_NAME="Crypto Prediction PSO-TFT"
ENV="development"
DEBUG=True
LOG_LEVEL="INFO"

# API Server Settings
HOST="0.0.0.0"
PORT=8000

# Database Configuration
DATABASE_URL="sqlite:///./crypto_prediction.db"

# Sentiment Analysis Keys (Optional/Fallback to mock if empty)
TWITTER_BEARER_TOKEN=""
REDDIT_CLIENT_ID=""
REDDIT_CLIENT_SECRET=""
REDDIT_USER_AGENT="CryptoSentimentBot/1.0"

# Binance WebSocket / API Configuration
BINANCE_WS_URL="wss://stream.binance.com:9443/ws"

# Ollama Local LLM Configuration
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3"